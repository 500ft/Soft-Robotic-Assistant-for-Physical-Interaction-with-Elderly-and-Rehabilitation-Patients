% [G3]
@misc{cfr1980ideapplicability,
  author       = {{U.S. Government}},
  title        = {21 {CFR} 812.2 --- Applicability (Investigational Device Exemptions)},
  howpublished = {Code of Federal Regulations, Title 21},
  year         = {1980},
  url          = {https://www.law.cornell.edu/cfr/text/21/812.2},
  note         = {(a) ``This part applies to all clinical investigations of devices to determine safety and
                  effectiveness, except as provided in paragraph (c).''
                  (b)(1) nonsignificant risk device investigations are treated as having an approved IDE if the sponsor
                  labels per 812.5, obtains IRB approval after presenting the IRB ``a brief explanation of why the device
                  is not a significant risk device'', obtains informed consent per part 50, monitors per 812.46, and keeps
                  the specified records and reports. (c) exemptions do not cover a load-bearing assistive prototype:
                  (c)(4) requires that testing ``is not for the purpose of determining safety or effectiveness and does
                  not put subjects at risk''. Text from Cornell LII; ecfr.gov blocks automated fetch}
}

% [G3]
@misc{cfr1980significantriskdefinition,
  author       = {{U.S. Government}},
  title        = {21 {CFR} 812.3 --- Definitions (significant risk device, sponsor, sponsor-investigator, subject)},
  howpublished = {Code of Federal Regulations, Title 21},
  year         = {1980},
  url          = {https://www.law.cornell.edu/cfr/text/21/812.3},
  note         = {(m) significant risk device includes a device that ``otherwise presents a potential for serious risk
                  to the health, safety, or welfare of a subject'' --- the catch-all that a body-weight-supporting
                  prototype must be argued against. (o) sponsor-investigator carries both sponsor and investigator
                  obligations, which is the likely posture of a student team. Text from Cornell LII}
}

% [G3]
@misc{cfr2015poweredexoskeleton,
  author       = {{U.S. Government}},
  title        = {21 {CFR} 890.3480 --- Powered lower extremity exoskeleton},
  howpublished = {Code of Federal Regulations, Title 21},
  year         = {2015},
  url          = {https://www.law.cornell.edu/cfr/text/21/890.3480},
  note         = {Class II with special controls. Closest published FDA classification analogue to this project;
                  the special controls enumerate biocompatibility, EMC/EMI, electrical, thermal, mechanical, battery and
                  wireless testing, software V\&V and hazard analysis, mechanical bench and durability testing,
                  cyclic-loading simulated-use testing of commands and safeguards under worst-case conditions and after
                  durability testing, manual override validation, clinical testing, and a training program.
                  Whether an upper-body analogue regulation exists is UNVERIFIED --- 21 CFR 890 was not walked this pass.
                  Text from Cornell LII}
}

% [G3]
@misc{hhs2018commonrule,
  author       = {{U.S. Government}},
  title        = {45 {CFR} 46.102 --- Definitions for purposes of this policy (Common Rule)},
  howpublished = {Code of Federal Regulations, Title 45},
  year         = {2018},
  url          = {https://www.law.cornell.edu/cfr/text/45/46.102},
  note         = {(e)(1) ``Human subject means a living individual about whom an investigator (whether professional or
                  student) conducting research: (i) Obtains information or biospecimens through intervention or
                  interaction with the individual...'' (e)(2) ``Intervention includes both physical procedures by which
                  information or biospecimens are gathered ... and manipulations of the subject or the subject's
                  environment that are performed for research purposes.'' Student investigator status is explicitly
                  no exemption. Text from Cornell LII}
}

