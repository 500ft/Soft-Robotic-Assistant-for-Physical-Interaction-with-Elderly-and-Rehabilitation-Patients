@misc{beri2021softgripper,
  author       = {Beri, Alekh Rajesh},
  title        = {Soft robotic assistive gripping device},
  howpublished = {Patent US11027436B2 (granted 2021-06-08); pre-grant publication US20180361596A1; application 15/958,744},
  year         = {2021},
  institution  = {Unassigned (individual inventor)},
  url          = {https://patents.google.com/patent/US11027436B2/en},
  note         = {P-VERIFIED. Priority 2017-06-19, filed 2018-04-20. Two to ten moulded silicone inflatable arms with an overlaid skin layer, for impaired grasp (diabetic neuropathy). Actuation under 5 psi (demonstrated under 4 psi); grip capability up to 17000 g (approx 167 N); body Shore 00-30 to 30A, skin Shore 00-30 to 50A and about 2 mm thick; channels 1-2 mm; fingertip micro-channels 100-500 um; flex sensors 0-180 deg; TMP36 and FlexiForce A301 sensors. References-cited list confirms three Polygerinos papers (IROS 2013; IEEE 2015; Robotics and Autonomous Systems 73:135-143, 2015) plus Mosadegh 2014, Rus 2015, Deimel 2015. WEARABLE/handheld. Active to 2039-02-21. Fetched 2026-09-24}
}

