                  HIC36 below 25 at 2 m/s against a limit of 650 (5 percent AIS3+);
                  a_3ms limit 72 g. Concludes automotive severity indices do not
                  transfer to robotics. Evaluated on average male dummies only}
}

@article{haddadin2012injuryknowledge,
  author       = {Haddadin, Sami and Haddadin, Simon and Khoury, Augusto and
