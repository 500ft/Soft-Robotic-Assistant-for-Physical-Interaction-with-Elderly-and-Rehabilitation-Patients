@inproceedings{haddadin2007crashtesting,
  author       = {Haddadin, Sami and Albu-Sch{\"a}ffer, Alin and Hirzinger, Gerd},
  title        = {Safety evaluation of physical human-robot interaction via
                  crash-testing},
  booktitle    = {Robotics: Science and Systems {III}},
  pages        = {217--224},
  year         = {2007},
  publisher    = {MIT Press},
  doi          = {10.15607/RSS.2007.III.028},
  url          = {https://www.roboticsproceedings.org/rss03/p28.pdf},
  note         = {Open access. DLR LWR III (14 kg, approx. 4 kg reflected mass at TCP)
